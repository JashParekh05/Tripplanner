# Flight Monitor Configuration

# Email Notifications (Gmail SMTP)
EMAIL_ENABLED=true
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_TO=your-destination@email.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# SMS Notifications (Optional - Twilio)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

# API Keys for Flight Data Sources
SERPAPI_KEY=your-serpapi-key
SKYSCANNER_API_KEY=your-skyscanner-rapidapi-key
KAYAK_API_KEY=your-kayak-rapidapi-key

# Flight Search Parameters
ORIGIN_AIRPORT=ATL
DESTINATION_AIRPORTS=MAD,BCN,VLC,SVQ,AGP
FINAL_DESTINATION=MAD
DEPARTURE_DATE=2025-03-20
RETURN_DATE=2025-03-29
DATE_FLEXIBILITY=3
MAX_PRICE=600
CURRENCY=USD

# Alternative European Hubs (for multi-leg searches)
EU_HUB_AIRPORTS=LHR,CDG,AMS,FRA,FCO

# Multi-Modal Journey Settings (Flight + Train)
ENABLE_TRAIN_SEARCH=true
ENABLE_ALTERNATIVE_AIRPORTS=true
EUR_TO_USD_RATE=1.10

# Train API Keys (Optional)
ROME2RIO_API_KEY=your-rome2rio-key
TRAINLINE_API_KEY=your-trainline-key

# Monitoring Settings
CHECK_INTERVAL_HOURS=6
ENABLE_MULTI_LEG_SEARCH=true
PRICE_DROP_THRESHOLD=50
